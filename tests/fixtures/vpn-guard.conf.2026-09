# ---------------------------------------------------------------------------
# vpn-guard.conf — читается демоном от root. Синтаксис zsh.
# Файл должен принадлежать root и НЕ быть доступным на запись группе/всем,
# иначе демон его проигнорирует (иначе это дыра: любой смог бы вписать сюда код).
# После правки перечитывается автоматически, перезапускать демон не нужно.
# ---------------------------------------------------------------------------

# === 1. Что охраняем =======================================================
# Полные пути к .app. Проверь путь: ls -d "/Applications/Имя.app"
APPS=(
  "/Applications/Claude.app"
  # "/Applications/Telegram.app"
  # "/Applications/Google Chrome.app"
  # "/Applications/Transmission.app"
)

# === 2. Как понять, что VPN поднят =========================================
# Правила (можно несколько):
#   route                  — маршрут по умолчанию идёт через туннель (utun/ppp/ipsec/tun/tap)
#   nc:Имя                 — сервис с таким именем в `scutil --nc list` в статусе Connected
#   scutil                 — ЛЮБОЙ VPN-сервис Connected  (осторожно: Tailscale почти всегда Connected)
#   iface:utun5            — на интерфейсе есть IPv4-адрес
#   default-iface:utun5    — маршрут по умолчанию именно через этот интерфейс
#   proc:openvpn           — запущен процесс с таким именем
#   geo                    — страна выхода в интернет НЕ из BLOCK_COUNTRIES (спрашивает Cloudflare)
#   geo:!RU                — то же, со своим списком (старый вид; если страны выбраны в
#                            Vafa.app — работает список оттуда)
#   geo:FR,NL              — страна выхода — одна из перечисленных
#   script:/путь/к/скрипту — свой скрипт: код возврата 0 = VPN есть
#
# VPN_REQUIRE=all — должны выполниться ВСЕ правила (по умолчанию, надёжнее)
# VPN_REQUIRE=any — достаточно любого
#
# На этой машине под рукой (по состоянию на 2026-09-10):
#   "Happ Plus"  — держал маршрут по умолчанию (utun5)
#   "Tailscale"  — числится Connected постоянно, как признак VPN не годится
# Маршрут через туннель И страна выхода не из списка ниже. Нет ответа от Cloudflare —
# считается, что VPN нет (лучше лишний раз заблокировать, чем пропустить).
VPN_CHECK=( route geo )
VPN_REQUIRE=all

# Страны, из которых VPN считается выключенным (двухбуквенные коды ISO: RU — Россия,
# CN — Китай, BY — Беларусь, IR — Иран). Удобнее выбирать в щите: «Выбрать страны…» —
# выбор пишется в /usr/local/etc/vpn-guard.countries и главнее этого списка.
BLOCK_COUNTRIES=( RU CN BY IR )

# === 3. Что делать, когда VPN пропал =======================================
# freeze — заморозить процессы (SIGSTOP). Данные не теряются, при возврате VPN
#          приложение продолжает с того же места. Рекомендуется.
# kill   — закрыть (SIGTERM, затем SIGKILL). Несохранённое может пропасть.
ON_DOWN=freeze

# Снимать бит +x с бинарей бандла, чтобы приложение вообще нельзя было открыть
# (ни из Dock, ни из Spotlight, ни через `open -a`). 1 = да.
LOCK_LAUNCH=1

# Ловить процессы приложения, даже если бандл скопировали в другое место
# (сравнение по имени исполняемого файла). 1 = да. Может дать ложные срабатывания,
# если имя бинаря неуникальное.
MATCH_ANY_PATH=0

# === 4. Сетевой блок (сайт в браузере, CLI, любые программы) ================
# Подсети, куда нельзя ходить мимо VPN. Режется через pf (системный файрвол):
#   VPN выключен -> к ним нельзя вообще, уже открытые соединения рвутся;
#   VPN включён  -> можно только через туннельный интерфейс, так что при
#                   падении VPN трафик режется сразу, не дожидаясь опроса.
# Пусто = сетевой блок выключен.
#
# Ниже все подсети Anthropic (AS399358): claude.ai, claude.com, anthropic.com,
# api.anthropic.com. Проверено 2026-09-11 по whois.radb.net. Обновить при нужде:
#   whois -h whois.radb.net -- '-i origin AS399358'
BLOCK_NETS=(
  160.79.104.0/23
  160.79.106.0/24
  209.249.57.0/24
  38.46.212.0/24
  38.84.152.0/24
  2607:6bc0::/32
)

# === 5. Тайминги ===========================================================
INTERVAL=1       # как часто проверять маршрут, секунд (по событию сети — сразу)
GEO_TTL=1        # как часто спрашивать страну выхода у Cloudflare при поднятом VPN, секунд
GEO_TTL_DOWN=1   # то же во время блокировки
NET_WATCH=1      # 1 = следить за сетью (route -n monitor): VPN упал, поднялся, сменил
                 # адрес — проверка и страна сразу, без ожидания таймера
GRACE=0      # сколько терпеть падение VPN до блокировки, секунд (0 = сразу)
NOTIFY=1     # показывать уведомление при смене состояния
