#!/bin/sh
# Загрузочный замок Vafa. Запускается при старте системы (LaunchDaemon local.vpnguard.bootlock).
#
# Правила pf на macOS при перезагрузке стираются, заново их ставит демон vpn-guard — большой
# zsh-скрипт, которому надо прочитать конфиг и стартовать. Замок от него не зависит: он только
# включает pf и грузит в якорь заранее сохранённый набор «закрыто» (таблица адресов + block,
# без пропуска). Ничего не проверяет и не открывает — открыть сеть может только демон, когда
# убедится в VPN и стране. Не запустился демон — сеть к адресам остаётся закрытой.
#
# Файл правил пишет сам демон (boot.rules); «Охрана выключена» и удаление его стирают —
# тогда замок ничего не делает.
S=${VPN_GUARD_STATE:-/usr/local/var/vpn-guard}
P=${VPN_GUARD_PFCTL:-/sbin/pfctl}
A=com.apple/000.vpn-guard
R=$S/boot.rules

[ -s "$R" ] || exit 0
# якорь уже не пуст — демон успел раньше (или замок запустили не при загрузке): не трогать,
# иначе стёрли бы его пропуск через туннель
[ -z "$("$P" -a "$A" -s rules 2>/dev/null)" ] || exit 0
# точка подключения com.apple/* — в штатном /etc/pf.conf; после загрузки ядро может быть пустым
"$P" -s rules 2>/dev/null | grep -q 'anchor "com.apple/\*"' || "$P" -f /etc/pf.conf >/dev/null 2>&1
"$P" -a "$A" -f "$R" >/dev/null 2>&1 || exit 1
# включить pf; токен — туда же, где его ищет демон (иначе он включил бы pf второй раз)
tok=$("$P" -E 2>&1 | awk '/[Tt]oken/{print $NF; exit}')
[ -n "$tok" ] && printf '%s\n' "$tok" > "$S/pf.token"
exit 0
