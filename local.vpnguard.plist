<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.vpnguard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/vpn-guard</string>
        <string>daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <!-- Background урезает процессор: круг шёл раз в 4 с вместо 1 с (замер 2026-10-09).
         Нагрузка демона с дочерними процессами — ~4 % одного ядра (33 процесса приложения) -->
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/vpn-guard.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/vpn-guard.log</string>
</dict>
</plist>
